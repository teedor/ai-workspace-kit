{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Edit(./status.md)",
      "Edit(./handover.md)",
      "Edit(./done.md)",
      "Edit(./review-queue.md)",
      "Edit(./inbox/jots.md)",
      "Edit(./ideas/**)",
      "Edit(./decisions/**)",
      "Edit(./notes/**)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "PowerShell(git ls-files *)",
      "PowerShell(git grep *)"
    ],
    "ask": [
      "Edit(./notes/ai-policy.md)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git -C *)",
      "Bash(rm:*)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout *)",
      "PowerShell(git restore *)",
      "PowerShell(git switch *)",
      "PowerShell(git stash *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git -C *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/kaggle.json)",
      "Read(**/secrets.toml)",
      "Read(**/client_secret*.json)"
    ]
  }
}
